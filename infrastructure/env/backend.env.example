# Backend app runtime variables (Spring Boot)
SERVER_PORT=8082

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portal
DB_USERNAME=postgres
DB_PASSWORD=postgres_dev_password
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# Keycloak
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/purchasing-portal
KEYCLOAK_CLIENT_ID=prp-backend

# Kafka (outside docker use localhost:29092 if needed)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=prp-backend

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# Camunda local admin
CAMUNDA_ADMIN_USER=admin
CAMUNDA_ADMIN_PASSWORD=admin
