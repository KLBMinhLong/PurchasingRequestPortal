# Copy this file to .env (same folder) and customize values for local development.
# Example run:
# docker compose --env-file infrastructure/env/.env -f infrastructure/docker-compose.yml up -d

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=portal

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_REALM=purchasing-portal
KEYCLOAK_CLIENT_ID=prp-backend
KEYCLOAK_CLIENT_SECRET=prp-backend-dev-secret
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_password

# Keycloak SPI (portal.identity)
SPI_DB_JDBC_URL=jdbc:postgresql://postgres:5432/portal
SPI_DB_USERNAME=keycloak_spi
SPI_DB_PASSWORD=keycloak_spi_dev_password
SPI_DB_DRIVER=org.postgresql.Driver
SPI_DB_SCHEMA=identity
SPI_HIKARI_MAX_POOL_SIZE=5
SPI_HIKARI_MIN_IDLE=1
SPI_HIKARI_CONNECTION_TIMEOUT_MS=30000

# Redis
REDIS_PASSWORD=redis_dev_password

# Camunda
CAMUNDA_DB_NAME=camunda
CAMUNDA_DB_USER=camunda
CAMUNDA_DB_PASSWORD=camunda_dev_password
